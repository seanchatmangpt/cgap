{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/ban_generic_agents.py\""
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-generated.sh\""
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-secrets.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && cargo check -p cgap-blake3 -p cgap-core -q 1>&2 || exit 2"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/fmt-edited.sh\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(cargo test *)",
      "Bash(cargo check *)",
      "Bash(cargo metadata --no-deps *)",
      "Bash(cargo metadata --no-deps)",
      "Bash(cargo bench --no-run *)",
      "Bash(python3 scripts/boundary_gate.py)",
      "Bash(python3 scripts/zero_string_gate.py)",
      "Bash(python3 scripts/zero_string_gate.py --self-check)",
      "Bash(curl -A cgap-publish-receipt https://index.crates.io/*)",
      "Bash(ls *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)"
    ],
    "ask": [
      "Bash(git push *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./secrets/**)"
    ]
  }
}
