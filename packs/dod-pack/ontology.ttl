@prefix dod: <urn:cgap:dod:> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

# cgap definition-of-done graph (v26.11.3). One individual per DoD gate.
# Standing vocabulary: MEASURED (an exit record exists on disk in the cited
# receipt), TARGET-UNMEASURED (in flight, no exit record — never rounded up),
# UNSUPPORTED (no receipt found on disk). The graph is the single source of
# truth for the DoD checklist; the rendered .md files are projections, never
# a second source of truth (GGM-SRC-002).

dod:DoDGate a rdfs:Class ;
    rdfs:label "Definition-of-done gate" ;
    rdfs:comment "One v26.11.3 DoD gate: a check command, the receipt whose exit record proves it, and a standing. A gate with standing TARGET-UNMEASURED is never publish-blocking." .

dod:DoDTarget a rdfs:Class ;
    rdfs:label "Aspirational DoD row" ;
    rdfs:comment "A definition-of-done row with no exit record on disk yet; carries a named close condition. Never publish-blocking by construction." .

# ---- properties ----

dod:gateId a owl:DatatypeProperty ;
    rdfs:domain dod:DoDGate ;
    rdfs:comment "Unique id, dod-001..dod-NNN." .

dod:targetId a owl:DatatypeProperty ;
    rdfs:domain dod:DoDTarget ;
    rdfs:comment "Unique id, dod-t-001..dod-t-NNN." .

dod:description a owl:DatatypeProperty ;
    rdfs:comment "What the gate proves." .

dod:checkCommand a owl:DatatypeProperty ;
    rdfs:domain dod:DoDGate ;
    rdfs:comment "The actual shell command whose exit record is the gate." .

dod:evidenceReceipt a owl:DatatypeProperty ;
    rdfs:comment "Path to the receipt carrying the exit record (cgap-rooted unless the value is absolute)." .

dod:standing a owl:DatatypeProperty ;
    rdfs:comment "MEASURED | TARGET-UNMEASURED | UNSUPPORTED. Never round up." .

dod:publishBlocking a owl:DatatypeProperty ;
    rdfs:domain dod:DoDGate ;
    rdfs:comment "true only for MEASURED gates that block publish." .

dod:closeCondition a owl:DatatypeProperty ;
    rdfs:domain dod:DoDTarget ;
    rdfs:comment "Named close condition: the observation that flips this row to MEASURED." .

# ---- individuals ----

dod:g-001 a dod:DoDGate ; dod:gateId "dod-001" ;
    dod:description "cargo test -p cgap-arrow: full arrow suite, 0 failures (220 passed at CG-1, 228 at SA-4)" ;
    dod:checkCommand "cargo test -p cgap-arrow" ;
    dod:evidenceReceipt "docs/jira/v26.11.3/receipts/cg-1.md" ;
    dod:standing "MEASURED" ;
    dod:publishBlocking true .

dod:g-002 a dod:DoDGate ; dod:gateId "dod-002" ;
    dod:description "cargo check -p cgap-aoq compiles clean" ;
    dod:checkCommand "cargo check -p cgap-aoq" ;
    dod:evidenceReceipt "docs/jira/v26.11.3/receipts/ab-1.md" ;
    dod:standing "MEASURED" ;
    dod:publishBlocking true .

