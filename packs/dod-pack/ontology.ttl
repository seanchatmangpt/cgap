# ---- aspirational targets (no exit record on disk, 2026-11-03) ----

dod:t-001 a dod:DoDTarget ; dod:targetId "dod-t-001" ;
    dod:description "index 177/177 exit gate (full index pass, every row exit-recorded)" ;
    dod:closeCondition "A wave-index exit record showing 177/177 (exit status 0 or N passed / 0 failed) is receipted on disk and cited here." ;
    dod:standing "TARGET-UNMEASURED" .

dod:t-002 a dod:DoDTarget ; dod:targetId "dod-t-002" ;
    dod:description "gofmt/goldens green for arcus-plane references (arcus goldens verify including cgap-facing rows)" ;
    dod:closeCondition "bash /Users/sac/arcus/tests/goldens/verify.sh exits 0 with the arcus-plane reference rows present, receipted in a cgap v26.11.3 receipt." ;
    dod:standing "TARGET-UNMEASURED" .
